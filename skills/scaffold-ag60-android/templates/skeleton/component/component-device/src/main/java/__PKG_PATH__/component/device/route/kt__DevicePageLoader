/**
 * @Author      ZhangHongYu
 * @Date        2026/02/09
 * @Description
 */
@AutoService(IPageLoader::class)
class DevicePageLoader : IPageLoader {

    override val tag: ModuleTag = ModuleTag.COMPONENT_DEVICE

    override fun loadPage(path: RoutePath, extras: Bundle?): RouteDestination? {
        if (path !is DevicePath) {
            return null
        }
        if (!AppCapability.ISO_BUS.isSupport() && path in ISO_BUS_PATHS) {
            return null
        }

        return when (path) {
            DevicePath.DEVICE_GNSS -> FragmentDestination(SettingRtkContainerFragment::class.java)
            DevicePath.DEVICE_VEHICLE_HOME -> FragmentDestination(DeviceVehicleHomeFragment::class.java)
            DevicePath.DEVICE_VEHICLE_EDIT -> FragmentDestination(DeviceVehicleEditFragment::class.java)
            DevicePath.DEVICE_VEHICLE_CALIBRATION -> FragmentDestination(DeviceVehicleCalibrationFragment::class.java)
            DevicePath.DEVICE_FARM_TOOLS_HOME -> FragmentDestination(DeviceFarmToolHomeFragment::class.java)
            DevicePath.DEVICE_FARM_TOOLS_EDIT -> FragmentDestination(DeviceFarmToolEditFragment::class.java)
            DevicePath.DEVICE_FARM_TOOLS_ISOBUS_CONTROL_EDIT -> FragmentDestination(DeviceFarmToolIsobusControlEditFragment::class.java)
            DevicePath.DEVICE_FARM_TOOLS_ISOBUS_MATERIAL_SELECT -> FragmentDestination(IsobusMaterialSelectFragment::class.java)
            DevicePath.DEVICE_UTURN_SETTING -> FragmentDestination(DeviceUTurnSettingFragment::class.java)
            DevicePath.DEVICE_VEHICLE_CALIBRATION_ATTITUDE_WORK -> FragmentDestination(DeviceVehicleAttitudeCalibrationWorkFragment::class.java)
            DevicePath.DEVICE_DEVICE_ADVANCED_PARAMETER_SETTING -> FragmentDestination(DeviceVehicleAdvancedParameterFragment::class.java)
            DevicePath.DEVICE_GNSS_SATELLITE_INFO -> FragmentDestination(SettingRtkSatelliteInfoFragment::class.java)
        }
    }

    private companion object {
        val ISO_BUS_PATHS = setOf(
            DevicePath.DEVICE_FARM_TOOLS_ISOBUS_CONTROL_EDIT,
            DevicePath.DEVICE_FARM_TOOLS_ISOBUS_MATERIAL_SELECT,
        )
    }
}