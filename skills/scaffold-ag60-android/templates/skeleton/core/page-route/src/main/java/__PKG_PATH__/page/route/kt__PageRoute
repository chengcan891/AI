object PageRoute {

    @Volatile
    private var exceptionHandler: RouteExceptionHandler? = null

    /**
     * 注册全局路由访问异常处理器。
     *
     * @param handler 异常处理器，传入 null 取消注册；未处理的异常继续抛出。
     */
    fun setExceptionHandler(handler: RouteExceptionHandler?) {
        exceptionHandler = handler
    }

    /**
     * 打开路由页面，访问限制交给外部注册的处理器处理。
     *
     * @param launcher Activity 结果启动器，为 null 时直接启动页面。
     * @param context 当前导航上下文。
     * @param path 目标路由。
     * @param extras 页面参数。
     * @param supportNavigation 是否使用带导航的 Fragment 容器。
     * @param exceptionHandler 本次调用的异常处理器，为 null 时使用公共处理器；返回 false 时直接抛出原异常。
     */
    fun navigation(launcher: ActivityResultLauncher<Intent>? = null, context: Context, path: RouteModuleConfig.RoutePath, extras: Bundle? = null, supportNavigation: Boolean = true, exceptionHandler: RouteExceptionHandler? = null) {
        handleRouteAccess(context, path, exceptionHandler) {
            navigationInternal(launcher, context, path, extras, supportNavigation)
        }
    }

    private fun navigationInternal(launcher: ActivityResultLauncher<Intent>?, context: Context, path: RouteModuleConfig.RoutePath, extras: Bundle?, supportNavigation: Boolean) {

        val destination = loadRouteDestination(path, extras) ?: throw Exception("PageRoute findRouteFail")
        if (destination is RouteDestination.DialogDestination) {
            showDialogFragment(context, destination, extras)
            return
        }

        val intent = when (destination) {
            is RouteDestination.ActivityDestination -> {
                Intent(context, destination.cls)
            }

            is RouteDestination.FragmentDestination -> {

                val cls = if (supportNavigation) {
                    val navigationPageContainer = loadRouteDestination(RouteModuleConfig.CommonPath.NAVIGATION_PAGE_CONTAINER) ?: throw Exception("PageRoute find NAVIGATION_PAGE_CONTAINER RouteFail")
                    (navigationPageContainer as RouteDestination.ActivityDestination).cls
                } else {
                    FragmentStackContainerActivity::class.java
                }

                val i = Intent(context, cls)
                i.putExtra(FragmentStackContainerActivity.EXTRA_FRAGMENT_NAME, destination.cls.name)
                i
            }

            is RouteDestination.DialogDestination -> {
                throw Exception("PageRoute DialogDestination only support dialog show")
            }
        }

        extras?.let {
            intent.putExtras(extras)
        }

        if (launcher != null) {
            launcher.launch(intent)
        } else {
            context.startActivity(intent)
        }
    }

    private fun showDialogFragment(context: Context, destination: RouteDestination.DialogDestination, extras: Bundle?) {
        val activity = context as? FragmentActivity ?: throw Exception("PageRoute DialogDestination need FragmentActivity context")
        val tag = destination.cls.name
        if (activity.supportFragmentManager.findFragmentByTag(tag) != null) {
            return
        }
        destination.loadDialogFragment(extras)?.show(activity.supportFragmentManager, tag)
    }

    /**
     * 加载 Fragment，访问限制交给外部注册的处理器处理。
     *
     * @param path 目标路由。
     * @param extras 页面参数。
     * @param context 提供给异常处理器的上下文，尚未附着的 Fragment 可不传；为 null 时访问限制异常直接抛出。
     * @param exceptionHandler 本次调用的异常处理器，为 null 时使用公共处理器；返回 false 时直接抛出原异常。
     * @return 加载的 Fragment；异常已处理、路由类型不匹配或实例化失败时返回 null。
     */
    fun loadFragment(path: RouteModuleConfig.RoutePath, extras: Bundle? = null, context: Context? = null, exceptionHandler: RouteExceptionHandler? = null): Fragment? {
        return handleRouteAccess(context, path, exceptionHandler) {
            val destination = loadRouteDestination(path, extras)

            if (destination !is RouteDestination.FragmentDestination) {
                return@handleRouteAccess null
            }

            destination.loadFragment(extras)
        }
    }

    private fun <T> handleRouteAccess(context: Context?, path: RouteModuleConfig.RoutePath, exceptionHandler: RouteExceptionHandler?, action: () -> T): T? {
        return try {
            action()
        } catch (exception: RouteAccessException) {
            val handler = exceptionHandler ?: this.exceptionHandler
            if (context == null || handler?.handle(context, path, exception) != true) {
                throw exception
            }
            null
        }
    }

    private val moduleTagMap = hashMapOf<RouteModuleConfig.ModuleTag, IPageLoader>()

    /**
     * 解析路由终点，直接调用时由调用方处理访问限制异常。
     *
     * @param path 目标路由。
     * @param extras 传递给业务加载器的页面参数。
     * @return 路由终点，未找到路由时返回 null。
     * @throws RouteAccessException 业务功能或注册授权不允许访问。
     */
    fun loadRouteDestination(path: RouteModuleConfig.RoutePath, extras: Bundle? = null): RouteDestination? {
        val tag = when (path) {
            is RouteModuleConfig.HomePath -> RouteModuleConfig.ModuleTag.COMPONENT_HOME
            is RouteModuleConfig.SettingPath -> RouteModuleConfig.ModuleTag.COMPONENT_SETTING
            is RouteModuleConfig.CommonPath -> RouteModuleConfig.ModuleTag.COMPONENT_COMMON
            is RouteModuleConfig.WorkPath -> RouteModuleConfig.ModuleTag.COMPONENT_WORK
            is RouteModuleConfig.ISOBUSPath -> RouteModuleConfig.ModuleTag.COMPONENT_ISOBUS
            is RouteModuleConfig.DevicePath -> RouteModuleConfig.ModuleTag.COMPONENT_DEVICE
            else -> null
        }

        if (tag == null) return null

        var pageLoader = moduleTagMap[tag]

        if (pageLoader == null) {
            val service = ServiceLoader.load(IPageLoader::class.java, IPageLoader::class.java.classLoader)
            service.forEach {
                if (pageLoader != null || it.tag != tag) {
                    return@forEach
                }

                pageLoader = it
                moduleTagMap[tag] = pageLoader!!
            }
        }

        val pege = pageLoader?.loadPage(path, extras)
        return pege

    }


    fun addFragmentToStack(activity: Activity, fragment: Fragment) {
        if (activity is IFragmentStackComponent) {
            (activity as IFragmentStackComponent).addFragmentToStack(fragment)
        } else {
            throw Exception("not in stack container activity, can't add fragment to stack")
        }
    }

    fun addFragmentToStackToTop(activity: Activity, fragment: Fragment) {
        if (activity is IFragmentStackComponent) {
            (activity as IFragmentStackComponent).addFragmentToStackToTop(fragment)
        } else {
            throw Exception("not in stack container activity, can't add fragment to stack")
        }
    }

    private var subPageControllerRef: WeakReference<SubPageController>? = null


    fun setSubPageController(pageController: SubPageController) {
        subPageControllerRef = WeakReference(pageController)
    }

    fun clearSubPageController() {
        subPageControllerRef = null
    }

    fun getSubPageController(): SubPageController? {
        return subPageControllerRef?.get()
    }

//    var currentHomePage: RouteModuleConfig.RoutePath = RouteModuleConfig.HomePath.HOME_WORK
//        private set

    val currentHomePage = MutableLiveData<RouteModuleConfig.RoutePath>(RouteModuleConfig.HomePath.HOME_WORK)


    var homeActivityReference: WeakReference<Activity>? = null

    fun setHomeActivity(activity: Activity) {
        homeActivityReference = WeakReference(activity)
    }

    fun finishToHome() {
        val homeActivity = homeActivityReference?.get() ?: return

        val activities = ActivityUtils.getActivityList()

        activities.asReversed().forEach { act ->
            if (act != homeActivity) {
                act.finish()
            }
        }
    }

    fun navigationFileExplore(
        launcher: ActivityResultLauncher<Intent>,
        context: Context,
        pattern: FileExploreConfig.Pattern?,
    ) {
        val bundle = Bundle()
        pattern?.let {
            bundle.putString(FileExploreConfig.EXTRA_PATTERN, Gson().toJson(it))
        }

        navigation(launcher, context, RouteModuleConfig.CommonPath.COMMON_FILE_EXPLORE, bundle)
    }

    fun isMainActivity(activity: Activity): Boolean {
        return activity == homeActivityReference?.get()
    }

    fun setAppKeyEventListener(listener: (activity: FragmentActivity, keyCode: Int, KeyEvent) -> Boolean) {
        AppComponentConfig.setAppKeyEventListener(listener)
    }

    fun navigationFileImport(launcher: ActivityResultLauncher<Intent>?, context: Context, pattern: FileExploreConfig.Pattern? = null) {
        val bundle = Bundle()
        pattern?.let {
            bundle.putString(FileExploreConfig.EXTRA_PATTERN, Gson().toJson(it))
        }

        navigation(launcher, context, RouteModuleConfig.CommonPath.COMMON_FILE_IMPORT, bundle)
    }

    fun navigationFileExport(launcher: ActivityResultLauncher<Intent>?, context: Context, pattern: FileExploreConfig.Pattern? = null, extras: Bundle? = null, share: Boolean) {
        val bundle = Bundle()
        pattern?.let {
            bundle.putString(FileExploreConfig.EXTRA_PATTERN, Gson().toJson(it))
        }
        extras?.let {
            bundle.putAll(it)
        }

        bundle.putBoolean(RouteConfig.EXTRA_DATA_BOOLEAN_KEY, share)

        navigation(launcher, context, RouteModuleConfig.CommonPath.COMMON_FILE_EXPORT, bundle)
    }

    fun navigationCloudFileExport(
        context: Context,
        file: File,
        fileExploreType: FileExploreConfig.CloudFileExploreType,
        newPage: Boolean,
    ) {
        val bundle = Bundle()
        bundle.putString(FileExploreConfig.EXTRA_CLOUD_FILE_PATH, file.absolutePath)
        bundle.putInt(FileExploreConfig.EXTRA_CLOUD_FILE_EXPLORE_TYPE, fileExploreType.id)

        navigation(
            context = context,
            path = if (newPage) {
                RouteModuleConfig.CommonPath.COMMON_CLOUD_FILE_EXPORT
            } else {
                RouteModuleConfig.CommonPath.COMMON_CLOUD_FILE_EXPORT_DIALOG
            },
            extras = bundle,
        )
    }

}
