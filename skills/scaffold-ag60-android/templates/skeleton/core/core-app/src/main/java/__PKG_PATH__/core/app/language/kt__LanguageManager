    val supportedLanguage: List<Locale>
        get() = listOf(*SUPPORT_LOCALE)

    /**
     * 获取本地化的显示语言名称
     *
     * @param locale
     * @return
     */
    fun getDisplayLanguage(locale: Locale, tip: String): String {
        if (Locale.SIMPLIFIED_CHINESE.language == locale.language) {
            if (Locale.TRADITIONAL_CHINESE.country == locale.country) {
                return "中文(繁體)"
            } else if (Locale.SIMPLIFIED_CHINESE.country == locale.country) {
                return "中文(简体)"
            }
            return locale.getDisplayLanguage(locale)
        } else if (RUSSIAN.language == locale.language) {
            return "Русский"
        } else if (FR.language == locale.language) {
            return "Français"
        } else if (SYS.language == locale.language) {
            return tip
        } else if (VI.language == locale.language) {
            return "Tiếng Việt"
        } else if (PO.language == locale.language) {
            return "Polski"
        } else if (KR.language == locale.language) {
            return "한국어"
        } else if (DU.language == locale.language) {
            return "Nederlands"
        } else {
            return locale.getDisplayLanguage(locale)
        }
    }

    /**
     * 获取语言的中文显示名称。
     * @param locale 目标语言地区信息
     * @param systemTip 系统默认语言的显示文案
     * @return 对应的中文语言名称
     */
    fun getChineseDisplayLanguage(locale: Locale): String {
        return when (locale.language) {
            SYS.language -> "跟随系统"
            Locale.SIMPLIFIED_CHINESE.language -> "简体中文"
            Locale.ENGLISH.language -> "英语"
            AR.language -> "阿拉伯语"
            HI.language -> "印地语"
            TURKISH.language -> "土耳其语"
            RUSSIAN.language -> "俄语"
            ES.language -> "西班牙语"
            EL.language -> "希腊语"
            BG.language -> "保加利亚语"
            FR.language -> "法语"
            JP.language -> "日语"
            VI.language -> "越南语"
            PO.language -> "波兰语"
            KR.language -> "韩语"
            DU.language -> "荷兰语"
            PT.language -> "葡萄牙语"
            DE.language -> "德语"
            IT.language -> "意大利语"
            HU.language -> "匈牙利语"
            else -> locale.getDisplayLanguage(Locale.SIMPLIFIED_CHINESE)
        }
    }

    fun isEnglish(context: Context): Boolean {
        return getDefault().language == LANGUAGE_ENGLISH
    }

    fun isChinese(): Boolean {
        return getDefault().language == LANGUAGE_CHINESE
    }

    fun getDefault(): Locale {
        val locale = Locale.getDefault()
        return adaptiveSupportLanguage(locale)
    }

    /**
     * 是否为支持的本地化
     *
     *
     * update by LiShuai 修改比较方式，改为同时比较language和country
     * 华为手机getDefault返回，简体中文：zh_Hans_CN
     * 繁体中文：zh_Hant_TW、zh_Hant_HK
     *
     * @param locale
     * @return true: 支持 , false: 不支持
     */
    fun isSupport(locale: Locale): Boolean {
        var supported = false

        for (l in SUPPORT_LOCALE) {
            if (l.language == locale.language) {
                if (LANGUAGE_CHINESE == l.language) {
                    if (l.country == locale.country) {
                        supported = true
                        break
                    }
                } else {
                    supported = true
                    break
                }
            }
        }
        return supported
    }

    fun getLocalByLanguage(language: String): Locale {
        return LanguageManager.supportedLanguage.firstOrNull {
            it.language == language
        } ?: getDefault()
    }

    @JvmStatic
    private fun adaptiveSupportLanguage(locale: Locale): Locale {

        if (supportedLanguage.contains(locale)) {
            return locale;
        }

        val matchedLanguages = supportedLanguage.filter { it.language == locale.language }

        if (matchedLanguages.isNullOrEmpty()) {
            return supportedLanguage[0]
        } else {
            val matchedCountries = matchedLanguages.filter { it.country == locale.country }
            if (!matchedCountries.isNullOrEmpty()) {
                return matchedCountries.first()
            }
        }
        return matchedLanguages.first()
    }
}
