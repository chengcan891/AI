    /**
     * 应用支持的本地化语言
     */
    private val SUPPORT_LOCALE = arrayOf(
        SYS,
        Locale.SIMPLIFIED_CHINESE,
        Locale.ENGLISH,
        AR,
        BG,
        DE,
        DU,
        EL,
        ES,
        FR,
        HI,
        HU,
        IT,
        JP,
        KR,
        PO,
        PT,
        RUSSIAN,
        TURKISH,
        VI,
