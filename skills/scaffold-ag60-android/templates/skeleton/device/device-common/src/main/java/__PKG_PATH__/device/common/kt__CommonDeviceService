/**
 * @Author      ZhangHongYu
 * @Date        2026/01/21
 * @Description
 */
class CommonDeviceService {

    companion object {
        val instance: CommonDeviceService by lazy(mode = LazyThreadSafetyMode.SYNCHRONIZED) { CommonDeviceService() }

        fun getHubCmdService(): IDeviceHubCmdService {
            return instance.controlService.hubCmdService
        }

    }

    /**
     * 设备公共数据监听
     */
    val messageService = CommonDeviceMessageService()

    /**
     * 设备信息临时监听
     */
    val tempMessageListenerService = TempDeviceMessageListenerService()

    val controlService = CommonDeviceControlService()

    private val deviceConnector = DeviceConnector()

    val deviceGnssManager = DeviceGnssManager()

    val deviceProfile = DeviceProfile()

    val externalRadioDeviceManager = ExternalRadioDeviceManager()

    private val externalRadioReconnectAttempted = AtomicBoolean(false)

    /**
     * 在外置电台当前不可用时执行一次重新连接。
     * CommonDeviceService 生命周期内最多触发一次实际重连；再次调用直接返回缓存状态。
     *
     * @return 当前或重连后的外置电台可用状态。
     */
    suspend fun retryExternalRadioConnectionOnce(): Boolean {
        if (externalRadioDeviceManager.supportExternalRadio) {
            return true
        }
        if (!externalRadioReconnectAttempted.compareAndSet(false, true)) {
            return externalRadioDeviceManager.supportExternalRadio
        }

        externalRadioDeviceManager.init()
        return externalRadioDeviceManager.awaitInitialized()
    }

    suspend fun initDeviceConnect(agType: AGType): Boolean =
        suspendCancellableCoroutine { cont ->
            deviceConnector.openSerialPort(agType) { success ->
                if (cont.isActive) {
                    cont.resume(success, null)
                }
            }

            deviceGnssManager.initConnection()
        }

    fun initMessageService() {
        messageService.init()
    }

    lateinit var radio: Radio

    suspend fun initDeviceProfile(agType: AGType) {
        deviceProfile.init(agType)
        val gnssModel = (deviceProfile.getFeatureInfo(DeviceFeatureType.FORMATED_GNSS_MODEL) as? GnssModelFeature)

        if (deviceProfile.hardwareResult == null || gnssModel == null) {
            log.error("deviceProfile init failed, hardwareResult: ${deviceProfile.hardwareResult}, gnssModel : $gnssModel")
            return
        }

        deviceGnssManager.initBoardService(gnssModel.feature)
        HubVersionCheck.instance.init(deviceProfile.getComponentVersion(DeviceComponentVersion.Type.HUB_VERSION)?.versionCode ?: 0)
    }


    suspend fun reloadDeviceProfile(){
        deviceProfile.reset()
        initDeviceProfile(AppFlavorService.instance.agType)
    }


    fun getPadDevice(): PadDevice {
        return deviceConnector.currentPadDevice
    }

    fun onDeviceDisconnect() {
        deviceProfile.reset()
        messageService.clear()
    }

    @Volatile
    private var lastReceiveHubMessageTime = 0L

    fun setReceiveHubMessage() {
        lastReceiveHubMessageTime = System.currentTimeMillis()
    }

    fun isHubConnect(): Boolean {
        return (System.currentTimeMillis() - lastReceiveHubMessageTime) < 3000
    }

}