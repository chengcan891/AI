package com.sinognss.ag.common.view

import android.content.Context
import android.content.res.ColorStateList
import android.graphics.Color
import android.util.AttributeSet
import android.util.TypedValue
import android.view.LayoutInflater
import android.view.View
import android.widget.LinearLayout
import androidx.activity.ComponentActivity
import androidx.core.view.isVisible
import com.blankj.utilcode.util.ActivityUtils
import com.sinognss.ag.common.view.databinding.ViewCommonStatueBarBinding

/**
 * @Author      ZhangHongYu
 * @Date        2026/01/04
 * @Description
 */
class CommonStatueBar @JvmOverloads constructor(
    context: Context,
    attrs: AttributeSet? = null,
    defStyleAttr: Int = 0,
) : LinearLayout(context, attrs, defStyleAttr) {

    private enum class CloseStyle(val id: Int) {
        NONE(0),
        LEFT(1),
        RIGHT(2);

        companion object {

            fun getById(id: Int): CloseStyle {

                return CloseStyle.values().firstOrNull {
                    it.id == id
                } ?: NONE
            }
        }

    }

    private enum class SizeStyle(val id: Int) {
        NORMAL(0),
        SMALL(1);

        companion object {

            fun getById(id: Int): SizeStyle {

                return SizeStyle.values().firstOrNull {
                    it.id == id
                } ?: NORMAL
            }
        }

    }

    private val binding: ViewCommonStatueBarBinding =
        ViewCommonStatueBarBinding.inflate(LayoutInflater.from(context), this, true)

    private var title: String = ""
    private var titleColor: Int? = null
    private var sizeStyle = SizeStyle.NORMAL
    private var closeStyle = CloseStyle.NONE

    private var barIconRes: Int = 0
    private var barIconColor: Int? = null
    private var barIconBg = Color.TRANSPARENT

    private var barIconRightRes: Int = 0

    init {
        val ta = context.theme.obtainStyledAttributes(attrs, R.styleable.StatueBar, defStyleAttr, 0)

        try {
            val count = ta.indexCount
            for (i in 0 until count) {
                val attr = ta.getIndex(i)

                when (attr) {
                    R.styleable.StatueBar_bar_title -> {
                        val textResId = ta.getResourceId(attr, 0)
                        title = if (textResId != 0) {
                            context.getString(textResId)
                        } else {
                            ta.getString(attr) ?: ""
                        }
                    }

                    R.styleable.StatueBar_close_style -> {
                        val id = ta.getInt(R.styleable.StatueBar_close_style, 0)
                        closeStyle = CloseStyle.getById(id)
                    }

                    R.styleable.StatueBar_bar_icon_res -> {
                        barIconRes = ta.getResourceId(attr, 0)
                    }

                    R.styleable.StatueBar_bar_icon_color -> {
                        val color = ta.getColor(attr, 0)
                        if (color != 0) {
                            barIconColor = color
                        }
                    }

                    R.styleable.StatueBar_bar_icon_bg_color -> {
                        barIconBg = ta.getColor(attr, Color.TRANSPARENT)
                    }

                    R.styleable.StatueBar_bar_title_color -> {
                        val color = ta.getColor(attr, 0)
                        if (color != 0) {
                            titleColor = color
                        }
                    }

                    R.styleable.StatueBar_bar_size_style -> {

                        val id = ta.getInt(attr, 0)
                        sizeStyle = SizeStyle.getById(id)
                    }

                    R.styleable.StatueBar_bar_icon_right_res ->{
                        barIconRightRes = ta.getResourceId(attr, 0)
                    }

                    else -> {}
                }
            }
        } catch (e: Exception) {
            e.printStackTrace()
        } finally {
            ta.recycle()
        }
        initView()

    }

    private fun initView() {

        when (closeStyle) {
            CommonStatueBar.CloseStyle.NONE -> {
                binding.layoutLeftClose.isVisible = false
                binding.layoutRightClose.isVisible = false
            }

            CommonStatueBar.CloseStyle.LEFT -> {
                binding.layoutLeftClose.isVisible = true
                binding.layoutRightClose.isVisible = false
            }

            CommonStatueBar.CloseStyle.RIGHT -> {
                binding.layoutLeftClose.isVisible = false
                binding.layoutRightClose.isVisible = true
            }
        }

        when (sizeStyle) {
            CommonStatueBar.SizeStyle.NORMAL -> {

                binding.tvTitle.setTextSize(TypedValue.COMPLEX_UNIT_PX, resources.getDimension(com.sinognss.common.res.R.dimen.text_size_l))

                val size = resources.getDimensionPixelSize(com.sinognss.common.res.R.dimen.icon_size_l)
                val params = binding.ivBarIcon.layoutParams
                params.width = size
                params.height = size
                binding.ivBarIcon.layoutParams = params
            }

            CommonStatueBar.SizeStyle.SMALL -> {

                binding.tvTitle.setTextSize(TypedValue.COMPLEX_UNIT_PX, resources.getDimension(com.sinognss.common.res.R.dimen.text_size_s))

                val size = resources.getDimensionPixelSize(com.sinognss.common.res.R.dimen.icon_size_default)
                val params = binding.ivBarIcon.layoutParams
                params.width = size
                params.height = size
                binding.ivBarIcon.layoutParams = params
            }
        }


        binding.tvTitle.text = title

        titleColor?.let {
            binding.tvTitle.setTextColor(it)
        }

        binding.layoutLeftClose.setOnClickListener {
            handleCloseClick(it)
        }

        binding.layoutRightClose.setOnClickListener {
            handleCloseClick(it)
        }

        if (barIconRes != 0) {
            binding.ivBarIcon.isVisible = true
            binding.ivBarIcon.setImageResource(barIconRes)
            binding.ivBarIcon.backgroundTintList = ColorStateList.valueOf(barIconBg)

            barIconColor?.let {
                binding.ivBarIcon.imageTintList = ColorStateList.valueOf(it)
            }
        }

        if (barIconRightRes != 0) {
            binding.ivBarIconRight.setImageResource(barIconRightRes)
            binding.layoutRightIcon.isVisible = true
        }

        binding.layoutRightIcon.setOnClickListener {
            clickRightListener?.invoke(it)
        }

    }

    private fun handleCloseClick(view: View) {
        val isIntercept = closeIntercept?.invoke(view) ?: false
        if (isIntercept) {
            return
        }

        val activity = ActivityUtils.getActivityByContext(view.context)
            ?: ActivityUtils.getActivityByContext(context)
            ?: ActivityUtils.getTopActivity()
        if (activity is ComponentActivity) {
            activity.onBackPressedDispatcher.onBackPressed()
        }
    }

    var clickRightListener:((View) -> Unit)? = {  }

    /**
     * 是否拦截返回事件
     * @return true 表示拦截返回事件，false 表示不拦截返回事件
     */
    var closeIntercept:((View) -> Boolean)?  = null

    fun setTitle(title: String) {
        this.title = title
        binding.tvTitle.text = title
    }

    fun setRightIconVisible(visible: Boolean) {
        binding.layoutRightIcon.isVisible = visible
    }

}