package com.sinognss.ag.common.view.rv

import android.view.LayoutInflater
import android.view.View
import android.view.ViewGroup
import androidx.viewbinding.ViewBinding
import com.chad.library.adapter.base.BaseQuickAdapter
import com.chad.library.adapter.base.viewholder.BaseViewHolder

/**
 * @Author      ZhangHongYu
 * @Date        2026/01/13
 * @Description
 */
open class BaseVBHolder<VB : ViewBinding>(val binding: VB) : BaseViewHolder(binding.root)

abstract class BaseVBAdapter<T, VB : ViewBinding>(private val layoutResId: Int) :
    BaseQuickAdapter<T, BaseVBHolder<VB>>(layoutResId) {

    override fun onCreateDefViewHolder(parent: ViewGroup, viewType: Int): BaseVBHolder<VB> {
        val view = LayoutInflater.from(parent.context).inflate(layoutResId, parent, false)
        val binding = initBinding(view)
        return BaseVBHolder(binding)
    }

    abstract fun initBinding(view: View): VB
}